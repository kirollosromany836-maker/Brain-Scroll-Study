{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "nixpacks": {
      "buildCommand": "cd backend && npm install && npm start"
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyLimit": 10,
    "rootDirectory": "backend"
  }
}

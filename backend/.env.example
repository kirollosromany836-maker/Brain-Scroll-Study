# Copy this file to .env and fill in real values before running the server.

# Port the API server listens on
PORT=4000

# Secret used to sign researcher JWT sessions. Generate a long random string,
# e.g. `openssl rand -hex 32`
JWT_SECRET=change_this_to_a_long_random_string

# How long a researcher login session stays valid
JWT_EXPIRES_IN=8h

# Path to the SQLite database file (used for local dev / demo).
# In production, swap the db layer for PostgreSQL/Supabase - see README.
SQLITE_PATH=./data/brainscroll.db

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:5173

# Symmetric key used to encrypt sensitive fields at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=change_this_to_a_32_byte_hex_key_0000000000000000000000000000
